[Unit]
Description=swap guard timer

[Timer]
# Check shortly after boot (a reboot or update is the usual way swap comes back)
# and then hourly. The point of this guard is a SHORT blind window, not surprise:
# the shorter the interval, the less time swap can sit active before it is caught.
# A small randomized delay only avoids every timer firing on the same second; it
# is not a secrecy measure, so it is kept small rather than large.
OnBootSec=2min
OnUnitActiveSec=1h
RandomizedDelaySec=2min
# Install with: systemctl enable --now swap-guard.timer

[Install]
WantedBy=timers.target
