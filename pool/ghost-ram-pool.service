[Unit]
Description=Build the RAM-backed qube pool for this boot profile
ConditionKernelCommandLine=ghostpool
After=qubesd.service
Requires=qubesd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ghost-ram-pool.sh
ExecStop=/usr/local/sbin/ghost-ram-pool-down.sh
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
