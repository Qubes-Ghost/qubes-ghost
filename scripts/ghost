#!/bin/bash
# ghost - the cycle: hidden store <-> qubes in RAM
# up <passphrase>       open the store, bring up the RAM pool
# load [archive] <qubes..> restore into RAM, sealed archive only
# air                   close the store, work with it gone from the system
# save <passphrase> <qubes..> save, seal, prune the older archives
# state-save <passphrase> <qube>  keep only what state-<qube>.list names
# state-load <qube>               put that back into a running qube
# ram                   check that the RAM pool is really in RAM
# sterile               check nothing of the session is left before power off
# state                 what the store says is sealed
# seal <archive>        seal an archive already in the store, as a new generation
# down <qubes..>        remove the qubes and the pool, close everything
set -u
D=${GHOST_DEV:-/dev/qubes_dom0/data}
BP=/root/.ghost.bp
STORE=${GHOST_STORE:-/mnt/store}
MAP=${GHOST_MAP:-/dev/mapper/ghosth}
SWAPS=${GHOST_SWAPS:-/proc/swaps}
ST="$STORE/ghost.state"

open_vol(){ [ -e "$MAP" ] && return 0
  printf '%s' "$1" | cryptsetup --type tcrypt --veracrypt --tcrypt-hidden open "$D" ghosth --key-file=- || return 1
  vgchange -ay vg1 >/dev/null; }
mount_store(){ mkdir -p "$STORE"; mountpoint -q "$STORE" || mount /dev/vg1/store "$STORE"; }
fix_rpool(){ vgchange -an rvg >/dev/null 2>&1; vgchange -ay rvg >/dev/null 2>&1; }

# --- the RAM pool being RAM ---------------------------------------------
# A pool named r1 proves nothing on its own: a stale or planted registration
# of that name could point at disk, and every later check would pass while the
# data landed on a platter. So follow the whole chain instead - pool r1, the
# volume group rvg, its one physical volume, the loop file behind it, and the
# filesystem that file lives on, which has to be tmpfs.
pool_field(){ qvm-pool info "$1" 2>/dev/null | awk -v k="$2" '$1==k{print $2; exit}'; }
vol_pool(){ qvm-volume info "$1:$2" 2>/dev/null | awk '$1=="pool"{print $2}'; }

ram_check(){
  local d vg tp pv n back fs opts
  d=$(pool_field r1 driver)
  [ "$d" = lvm_thin ] || { echo "pool r1 has driver '${d:-none}', expected lvm_thin" >&2; return 1; }
  vg=$(pool_field r1 volume_group)
  [ "$vg" = rvg ] || { echo "pool r1 uses volume group '${vg:-none}', expected rvg" >&2; return 1; }
  tp=$(pool_field r1 thin_pool)
  [ "$tp" = rpool ] || { echo "pool r1 uses thin pool '${tp:-none}', expected rpool" >&2; return 1; }
  n=$(pvs --noheadings -o pv_name,vg_name 2>/dev/null | awk '$2=="rvg"{print $1}' | wc -l)
  [ "$n" = 1 ] || { echo "volume group rvg has $n physical volumes, expected exactly one" >&2; return 1; }
  pv=$(pvs --noheadings -o pv_name,vg_name 2>/dev/null | awk '$2=="rvg"{print $1}')
  back=$(losetup -n -O BACK-FILE "$pv" 2>/dev/null)
  [ -n "$back" ] || { echo "$pv is not a loop device, so rvg is not backed by a file in RAM" >&2; return 1; }
  fs=$(findmnt -n -o FSTYPE --target "$back" 2>/dev/null)
  [ "$fs" = tmpfs ] || { echo "the loop file $back sits on ${fs:-an unknown filesystem}, not tmpfs - that is disk" >&2; return 1; }
  opts=",$(findmnt -n -o OPTIONS --target "$back" 2>/dev/null),"
  case "$opts" in *,noswap,*) ;;
    *) echo "warning: the tmpfs holding $back is mounted without noswap, its pages could reach swap" >&2 ;; esac
  return 0; }

# Every volume of a restored qube has to sit in r1. For an AppVM the root
# volume legitimately belongs to its template's pool, so only a standalone or
# a template is checked for root - otherwise a restored standalone could put
# its whole filesystem on disk and still be reported as a success.
placement_check(){
  local vm v p vols bad=0
  for vm in "$@"; do
    vols="private volatile"
    case "$(qvm-prefs "$vm" klass 2>/dev/null)" in
      StandaloneVM|TemplateVM) vols="root private volatile" ;; esac
    for v in $vols; do
      p=$(vol_pool "$vm" "$v"); [ -z "$p" ] && continue
      [ "$p" = r1 ] || { echo "LEAK: $vm:$v is in pool '$p', not in RAM" >&2; bad=1; }
    done
  done
  return $bad; }

# --- nothing of the session left -----------------------------------------
# What makes the disk sterile is the power going off: the tmpfs and everything
# in it exist only in RAM. This checks that nothing is still holding on to it
# beforehand - a qube, the pool, the volume group, the loop device, a mount, or
# the open store. The amnesic session takes care of dom0's own logs, which is
# why there is no scrubbing here.
sterile_check(){
  local bad=0 vm v p dev
  for vm in $(qvm-ls --raw-list 2>/dev/null); do
    for v in root private volatile; do
      p=$(vol_pool "$vm" "$v")
      [ "$p" = r1 ] && { echo "!! $vm:$v is still in the RAM pool" >&2; bad=1; }
    done
  done
  qvm-pool list 2>/dev/null | grep -qw r1 && { echo "!! pool r1 is still registered" >&2; bad=1; }
  vgs rvg >/dev/null 2>&1 && { echo "!! volume group rvg still exists" >&2; bad=1; }
  losetup -l -O BACK-FILE 2>/dev/null | grep -q '^/mnt/ram/' \
    && { echo "!! a loop device still backs a file in /mnt/ram" >&2; bad=1; }
  mountpoint -q /mnt/ram && { echo "!! /mnt/ram is still mounted" >&2; bad=1; }
  mountpoint -q "$STORE" && { echo "!! $STORE is still mounted" >&2; bad=1; }
  vgs vg1 >/dev/null 2>&1 && { echo "!! the store's volume group vg1 is still there" >&2; bad=1; }
  [ -e "$MAP" ] && { echo "!! the store is still open at $MAP" >&2; bad=1; }
  # zram swap lives in RAM and goes with the power; swap on a disk does not,
  # and anything paged out to it has already been written
  while read -r dev _; do
    case "$dev" in
      Filename|'') ;;
      /dev/zram*) echo "note: zram swap is active, it is in RAM and goes with the power" >&2 ;;
      *) echo "!! swap on $dev is active, pages may already be on disk" >&2; bad=1 ;;
    esac
  done < "$SWAPS"
  return $bad; }

# --- forward only ------------------------------------------------------
# The store carries a seal: gen, the generation number, one up per save;
# arc, the name of the only archive that may be loaded; sha, its hash;
# seen, the newest generation that has already been loaded.
# Taken as <seal file> <key>, because there is more than one seal now: one for
# the qube archives, and one per qube for its state bundles.
st_get(){ [ -f "$1" ] && sed -n "s/^$2=//p" "$1" | tail -1; }

st_put(){ # <seal file> gen arc sha seen - written whole, through a temp file
  local f="$1" t="$1.new"
  printf 'gen=%s\narc=%s\nsha=%s\nseen=%s\nsealed=%s\n' \
    "$2" "$3" "$4" "$5" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$t" || return 1
  sync "$t" 2>/dev/null
  mv -f "$t" "$f" || return 1
  sync "$STORE" 2>/dev/null; return 0; }

arc_hash(){ sha256sum "$STORE/$1" | cut -d' ' -f1; }

# The usable archive on stdout, the reason for a refusal on stderr.
seal_pick(){
  local f="$1" g a s n
  g=$(st_get "$f" gen); a=$(st_get "$f" arc); s=$(st_get "$f" sha)
  [ -n "$g" ] && [ -n "$a" ] && [ -n "$s" ] || { echo "the store carries no seal" >&2; return 1; }
  [ -f "$STORE/$a" ] || { echo "the sealed archive $a is gone from the store" >&2; return 1; }
  n=$(st_get "$f" seen); n=${n:-0}
  [ "$g" -ge "$n" ] || { echo "the store was wound back: seal is generation $g, but $n was already loaded" >&2; return 1; }
  [ "$(arc_hash "$a")" = "$s" ] || { echo "the hash of $a does not match the seal" >&2; return 1; }
  printf '%s' "$a"; }

# Older archives go only after the new one is sealed, so until that moment
# the store always has something loadable in it.
prune(){ # <name to keep> <prefix of the ones to consider>
  local keep="$1" pref="$2" f n=0
  for f in "$pref"*; do
    [ -e "$f" ] || continue
    [ "$(basename "$f")" = "$keep" ] && continue
    rm -f "$f" && n=$((n+1))
  done
  echo "$n"; }

case "${1:-}" in
up)
  open_vol "${2:?a passphrase is required}" || { echo UP-FAIL-OPEN; exit 1; }
  mount_store
  mkdir -p /mnt/ram
  # noswap keeps these pages out of swap; kernels before 6.4 do not have it,
  # and there the swap-guard scripts are the fallback
  mountpoint -q /mnt/ram || mount -t tmpfs -o size=40G,noswap tmpfs /mnt/ram 2>/dev/null \
    || mountpoint -q /mnt/ram || mount -t tmpfs -o size=40G tmpfs /mnt/ram \
    || { echo UP-FAIL-TMPFS; exit 1; }
  [ -f /mnt/ram/d.img ] || truncate -s 38G /mnt/ram/d.img
  L=$(losetup -j /mnt/ram/d.img | cut -d: -f1)
  [ -n "$L" ] || L=$(losetup -f --show /mnt/ram/d.img)
  vgs rvg >/dev/null 2>&1 || { pvcreate -ff -y "$L" >/dev/null; vgcreate rvg "$L" >/dev/null; lvcreate -l 95%FREE -T rvg/rpool >/dev/null; }
  fix_rpool
  qvm-pool list | grep -qw r1 || qvm-pool add r1 lvm_thin -o volume_group=rvg -o thin_pool=rpool -o revisions_to_keep=1 >/dev/null
  ram_check || { echo UP-FAIL-NOTRAM; exit 1; }
  echo UP-OK ;;
load)
  shift
  # an archive name may be given - it gets checked, not taken on trust
  WANT=""
  case "${1:-}" in *qubes-backup-*) WANT=$(basename "$1"); shift ;; esac
  [ $# -gt 0 ] || { echo LOAD-FAIL-NOVM; exit 1; }
  mountpoint -q "$STORE" || { echo LOAD-FAIL-NOSTORE; exit 1; }
  A=$(seal_pick "$ST") || { echo LOAD-REFUSE; exit 1; }
  if [ -n "$WANT" ] && [ "$WANT" != "$A" ]; then
    echo "LOAD-REFUSE-NOTNEWEST: asked for $WANT, sealed is $A"; exit 1; fi
  ram_check || { echo LOAD-REFUSE-NOTRAM; exit 1; }
  fix_rpool
  BEFORE=$(qvm-ls --raw-list | sort)
  OLD=$(qubes-prefs default_pool); echo "$OLD" > /run/ghost.oldpool
  qubes-prefs default_pool r1
  qvm-backup-restore --passphrase-file="$BP" "$STORE/$A" "$@"; R=$?
  qubes-prefs default_pool "$OLD"
  [ $R -eq 0 ] || { echo LOAD-FAIL; exit 1; }
  NEW=$(comm -13 <(echo "$BEFORE") <(qvm-ls --raw-list | sort))
  if ! placement_check $NEW; then
    echo "removing the restored qubes, they are not all in RAM" >&2
    for v in $NEW; do qvm-remove -f "$v" >/dev/null 2>&1; done
    echo LOAD-FAIL-NOTINRAM; exit 1
  fi
  G=$(st_get "$ST" gen); st_put "$ST" "$G" "$A" "$(st_get "$ST" sha)" "$G"
  echo "LOAD-OK archive=$A generation=$G in-ram=$(echo $NEW | wc -w)" ;;
air)
  umount "$STORE" 2>/dev/null
  vgchange -an vg1 >/dev/null 2>&1
  cryptsetup close ghosth 2>/dev/null
  [ -e "$MAP" ] && { echo AIR-FAIL; exit 1; }
  echo AIR-OK ;;
save)
  open_vol "${2:?a passphrase is required}" || { echo SAVE-FAIL-OPEN; exit 1; }
  shift 2; mount_store
  [ $# -gt 0 ] || { echo SAVE-FAIL-NOVM; exit 1; }
  for v in "$@"; do qvm-shutdown --wait "$v" >/dev/null 2>&1; done
  B=$(mktemp); ls -1 "$STORE" > "$B"
  qvm-backup --yes --passphrase-file="$BP" "$STORE" "$@" || { rm -f "$B"; echo SAVE-FAIL; exit 1; }
  sync
  A=$(ls -1 "$STORE" | grep -Fxv -f "$B" | grep '^qubes-backup-' | tail -1); rm -f "$B"
  [ -n "$A" ] || { echo SAVE-FAIL-NOARC; exit 1; }
  H=$(arc_hash "$A") || { echo SAVE-FAIL-HASH; exit 1; }
  G=$(st_get "$ST" gen); G=$(( ${G:-0} + 1 ))
  st_put "$ST" "$G" "$A" "$H" "$G" || { echo SAVE-FAIL-SEAL; exit 1; }
  N=$(prune "$A" "$STORE/qubes-backup-")
  echo "SAVE-OK generation=$G archive=$A pruned=$N" ;;
seal)
  # The hatch, and the way in from an older store that has archives but no
  # seal. The name has to be typed out, so no one goes back by accident, and
  # what gets sealed becomes a new generation, so the step leaves a trace.
  shift
  A="${1:?the archive name is required, it is never guessed for you}"; A=$(basename "$A")
  mountpoint -q "$STORE" || { echo SEAL-FAIL-NOSTORE; exit 1; }
  [ -f "$STORE/$A" ] || { echo "SEAL-FAIL: no $A in the store"; exit 1; }
  H=$(arc_hash "$A") || { echo SEAL-FAIL-HASH; exit 1; }
  G=$(st_get "$ST" gen); G=$(( ${G:-0} + 1 ))
  st_put "$ST" "$G" "$A" "$H" "$G" || { echo SEAL-FAIL; exit 1; }
  echo "SEAL-OK generation=$G archive=$A (older archives left alone, the next save prunes them)" ;;
state-save)
  # A whole qube image is a heavy thing to carry for a messenger whose secret
  # is a few megabytes of keys and database. This keeps only what the list
  # names, so the qube itself can be an ordinary one, built from a stock
  # template in RAM and thrown away at the end.
  open_vol "${2:?a passphrase is required}" || { echo STATE-SAVE-FAIL-OPEN; exit 1; }
  Q="${3:?a qube name is required}"; mount_store
  LIST="$STORE/state-$Q.list"; SEAL="$STORE/state-$Q.seal"
  [ -f "$LIST" ] || { echo "STATE-SAVE-FAIL: no $LIST, so nothing says what is worth keeping"; exit 1; }
  qvm-check --running "$Q" >/dev/null 2>&1 || { echo "STATE-SAVE-FAIL: $Q is not running"; exit 1; }
  PATHS=$(grep -v '^[[:space:]]*#' "$LIST" | grep -v '^[[:space:]]*stop:' \
          | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s#^/##' | grep -v '^$')
  [ -n "$PATHS" ] || { echo "STATE-SAVE-FAIL: $LIST names no paths"; exit 1; }
  # A messenger database copied while the messenger is writing to it is worth
  # nothing, so the list may carry a line that closes the app first.
  STOP=$(sed -n 's/^[[:space:]]*stop:[[:space:]]*//p' "$LIST" | head -1)
  if [ -n "$STOP" ]; then
    qvm-run --user root --pass-io "$Q" "$STOP" </dev/null >/dev/null 2>&1 || true
    sleep 3
  fi
  B="state-$Q-$(date -u +%Y-%m-%dT%H%M%S).tgz"
  qvm-run --user root --pass-io "$Q" "tar czf - -C / $PATHS" </dev/null > "$STORE/$B" \
    || { rm -f "$STORE/$B"; echo STATE-SAVE-FAIL; exit 1; }
  [ -s "$STORE/$B" ] || { rm -f "$STORE/$B"; echo "STATE-SAVE-FAIL: the bundle came out empty"; exit 1; }
  tar tzf "$STORE/$B" >/dev/null 2>&1 \
    || { rm -f "$STORE/$B"; echo "STATE-SAVE-FAIL: the bundle does not read back"; exit 1; }
  sync
  H=$(arc_hash "$B")
  G=$(st_get "$SEAL" gen); G=$(( ${G:-0} + 1 ))
  st_put "$SEAL" "$G" "$B" "$H" "$G" || { echo STATE-SAVE-FAIL-SEAL; exit 1; }
  N=$(prune "$B" "$STORE/state-$Q-")
  echo "STATE-SAVE-OK generation=$G bundle=$B bytes=$(stat -c%s "$STORE/$B") pruned=$N" ;;
state-load)
  Q="${2:?a qube name is required}"
  mountpoint -q "$STORE" || { echo STATE-LOAD-FAIL-NOSTORE; exit 1; }
  SEAL="$STORE/state-$Q.seal"
  B=$(seal_pick "$SEAL") || { echo STATE-LOAD-REFUSE; exit 1; }
  qvm-check --running "$Q" >/dev/null 2>&1 || { echo "STATE-LOAD-FAIL: $Q is not running"; exit 1; }
  qvm-run --user root --pass-io "$Q" "tar xzf - -C /" < "$STORE/$B" \
    || { echo STATE-LOAD-FAIL; exit 1; }
  G=$(st_get "$SEAL" gen); st_put "$SEAL" "$G" "$B" "$(st_get "$SEAL" sha)" "$G"
  echo "STATE-LOAD-OK bundle=$B generation=$G" ;;
sterile)
  if sterile_check; then echo "STERILE-OK nothing of the session is left, safe to power off"
  else echo STERILE-FAIL; exit 1; fi ;;
ram)
  if ram_check; then echo "RAM-OK pool r1 is backed by tmpfs"; else echo RAM-FAIL; exit 1; fi ;;
state)
  mountpoint -q "$STORE" || { echo "the store is not mounted"; exit 1; }
  if [ -f "$ST" ]; then cat "$ST"; else echo "no seal"; fi
  echo "--- archives in the store:"
  ls -1 "$STORE"/qubes-backup-* 2>/dev/null | xargs -r -n1 basename || true
  for f in "$STORE"/state-*.seal; do
    [ -e "$f" ] || continue
    q=$(basename "$f" .seal); q=${q#state-}
    echo "--- state of $q: generation $(st_get "$f" gen), $(st_get "$f" arc)"
  done ;;
down)
  shift
  for v in "$@"; do qvm-shutdown --wait "$v" >/dev/null 2>&1; qvm-remove -f "$v" >/dev/null 2>&1; done
  qvm-pool remove r1 >/dev/null 2>&1
  vgchange -an rvg >/dev/null 2>&1; vgremove -f rvg >/dev/null 2>&1
  losetup -D 2>/dev/null; umount /mnt/ram 2>/dev/null
  umount "$STORE" 2>/dev/null; vgchange -an vg1 >/dev/null 2>&1
  cryptsetup close ghosth 2>/dev/null
  sync
  if sterile_check; then echo "DOWN-OK nothing of the session is left, safe to power off"
  else echo "DOWN-NOT-CLEAN see the lines above, do not treat the disk as sterile"; exit 1; fi ;;
*) echo "ghost {up|load|air|save|state|seal|ram|state-save|state-load|sterile|down} ..." ;;
esac
