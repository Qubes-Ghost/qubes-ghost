#!/bin/bash
# 26_amnesic_pool - a second amnesic profile, for sessions that keep the qube
# pool in RAM as well as the root.
#
# A plain amnesic session only has to fit dom0's own root in memory. A session
# that also builds its pool there has to fit the templates it carries, and those
# are the expensive part - a template is gigabytes where a qube's own data is
# usually tens of megabytes. So this profile asks for a much larger dom0.
#
# Only the RAM-backed root mode is offered: an on-disk overlay defeats the point
# of carrying the pool in memory.
#
# Half the machine, with a floor of 16G. Half is deliberate: the pool and dom0
# live inside that share, the running qubes live outside it, and both need room.
# There is no ceiling - on a large machine half is still the right split, and
# capping it would only leave memory idle on one side of the line.
set -u
total=$(xl info 2>/dev/null | awk '/^total_memory/ {print $3; exit}')
case "${total:-}" in
    ''|*[!0-9]*) echo "26_amnesic_pool: cannot read total memory, skipping" >&2; exit 0 ;;
esac
h=$(( total / 2 ))
[ "$h" -lt 16384 ] && h=16384

# The marker word lets a service start in this profile only, via systemd's
# ConditionKernelCommandLine, without the service having to inspect anything.
exec env MODES=rootzram PREFIX="Amnesic+RAM pool" IDPFX=amnpool EXTRA=ghostpool DOM0_MEM="${h}M" \
     /etc/grub.d/25_amnesic
